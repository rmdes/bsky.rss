{
  "name": "bsky.rss",
  "version": "2.11.2",
  "description": "A configurable RSS poster for Bluesky",
  "main": "index.js",
  "repository": "https://github.com/rmdes/bsky.rss.git",
  "author": "Milan Mehra <milan@milanm.org>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:dev": "docker rmi -f bsky.rss && docker build . -t bsky.rss",
    "release": "sh release.sh",
    "start": "NODE_NO_WARNINGS=1 tsx ./app/index.ts",
    "dev": "tsx --watch ./app/index.ts",
    "dev:app": "tsx --watch ./app/index.ts",
    "dev:fleet": "tsx --watch ./fleet/runFleet.ts",
    "dev:debug": "node --inspect-brk node_modules/.bin/tsx ./app/index.ts",
    "dev:logs": "tail -f data/fleet/logs/*.log 2>/dev/null || echo 'No fleet logs yet'",
    "dev:clean": "rm -rf data/*.txt data/*.json data/persist.json data/last.txt",
    "fleet": "NODE_NO_WARNINGS=1 tsx ./fleet/runFleet.ts",
    "fleet:status": "NODE_NO_WARNINGS=1 tsx ./fleet/status.ts",
    "fleet:log": "NODE_NO_WARNINGS=1 tsx ./fleet/logControl.ts",
    "fleet:clean": "rm -rf data/fleet/*/state.sqlite data/fleet/*/state.sqlite-*",
    "docker": "bash release.sh",
    "docker:build": "docker build -t bsky-rss:dev .",
    "docker:run": "docker run --env-file .env -v $(pwd)/data:/build/data bsky-rss:dev",
    "docker:compose": "docker compose -f docker-compose.example.yml up",
    "typecheck": "tsc --noEmit --ignoreDeprecations 6.0",
    "test": "tsx --test **/*.test.ts",
    "test:app": "tsx --test app/**/*.test.ts",
    "test:fleet": "tsx --test fleet/*.test.ts",
    "test:feedSource": "tsx --test shared/feedSource/**/*.test.ts",
    "test:watch": "tsx --test --watch **/*.test.ts",
    "test:coverage": "c8 tsx --test **/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deps:check": "yarn outdated",
    "deps:update": "yarn upgrade-interactive",
    "deps:audit": "yarn npm audit"
  },
  "dependencies": {
    "@atproto/api": "0.20.42",
    "@atproto/xrpc": "0.8.11",
    "axios": "1.20.0",
    "dotenv": "^17.0.0",
    "feedsmith": "^2.9.6",
    "html-entities": "2.6.0",
    "jimp": "^1.6.1",
    "open-graph-scraper": "6.12.0",
    "tsx": "4.23.12"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "^10.0.0",
    "gts": "7.0.0",
    "typescript": "6.0.3",
    "underscore-cli": "^0.2.19"
  },
  "typeRoots": [
    "./node_modules/@types",
    "./app/types"
  ],
  "packageManager": "yarn@4.18.0",
  "resolutions": {
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript-eslint/scope-manager": "^8.67.0",
    "typescript-eslint": "^8.67.0"
  }
}
