{
  "name": "bsky.rss",
  "version": "2.9.0",
  "description": "A configurable RSS poster for Bluesky",
  "main": "index.js",
  "repository": "https://github.com/rmdes/bsky.rss.git",
  "author": "Milan Mehra <milan@milanm.org>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:dev": "docker rmi -f bsky.rss && docker build . -t bsky.rss",
    "release": "sh release.sh",
    "start": "NODE_NO_WARNINGS=1 tsx ./app/index.ts",
    "dev": "tsx --watch ./app/index.ts",
    "dev:app": "tsx --watch ./app/index.ts",
    "dev:fleet": "tsx --watch ./fleet/runFleet.ts",
    "dev:debug": "node --inspect-brk node_modules/.bin/tsx ./app/index.ts",
    "fleet": "NODE_NO_WARNINGS=1 tsx ./fleet/runFleet.ts",
    "fleet:status": "NODE_NO_WARNINGS=1 tsx ./fleet/status.ts",
    "fleet:log": "NODE_NO_WARNINGS=1 tsx ./fleet/logControl.ts",
    "docker": "bash release.sh",
    "typecheck": "tsc --noEmit --ignoreDeprecations 6.0",
    "test": "tsx --test **/*.test.ts",
    "test:app": "tsx --test app/**/*.test.ts",
    "test:fleet": "tsx --test fleet/*.test.ts",
    "test:watch": "tsx --test --watch **/*.test.ts",
    "test:coverage": "c8 tsx --test **/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@atproto/api": "0.20.38",
    "@atproto/xrpc": "0.8.10",
    "axios": "1.19.0",
    "dotenv": "^17.0.0",
    "feedsmith": "^2.9.6",
    "html-entities": "2.6.0",
    "jimp": "^1.6.1",
    "open-graph-scraper": "6.12.0",
    "tsx": "4.22.2"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "eslint": "^9.37.0",
    "gts": "7.0.0",
    "typescript": "6.0.3",
    "underscore-cli": "^0.2.19"
  },
  "typeRoots": [
    "./node_modules/@types",
    "./app/types"
  ],
  "packageManager": "yarn@4.18.0"
}
