# Copy to .env (gitignored) for local runs. Both `yarn start`/`yarn dev` and `yarn fleet`
# load it via dotenv. Production deployments use deploy/<fleet|canary>/ instead.

# --- Single-bot mode (yarn start / yarn dev) ---
# Required
IDENTIFIER=username.bsky.social
APP_PASSWORD=xxxx-xxxx-xxxx-xxxx   # an app password, never your main password
FETCH_URL=https://example.com/feed.xml
INSTANCE_URL=https://bsky.social

# Optional
FETCH_INTERVAL=5          # minutes between feed polls (default 5)
LOG_LEVEL=summary         # summary | verbose | debug (default summary)

# --- Shared ---
HEALTH_CHECK_PORT=8080    # /health endpoint (default 8080)

# --- Fleet mode (yarn fleet) ---
# Values shown are the defaults.
# FLEET_CONFIG_ROOT=./config.example
# FLEET_SECRETS_PATH=./config.example/secrets/bsky-fleet.json
# FLEET_DATA_ROOT=./data/fleet
# FLEET_LOCK_PATH=./data/fleet/fleet.pid
# FLEET_LOG_LEVEL=summary
# FLEET_SHUTDOWN_PER_BOT_TIMEOUT_MS=10000
# FLEET_SHUTDOWN_OVERALL_TIMEOUT_MS=30000
# DRY_RUN=true            # anything but "false" keeps the fleet from posting
# NTFY_URL=               # optional reply/mention notifications, see documentation/fleet.md
# NTFY_TOKEN=
