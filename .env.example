# Bluesky Account Configuration
APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
INSTANCE_URL=https://bsky.social
FETCH_URL=https://example.com/feed.xml
IDENTIFIER=username.bsky.social

# Optional Configuration
FETCH_INTERVAL=5
HEALTH_CHECK_PORT=8080
LOG_LEVEL=info

# Fleet Mode Configuration
FLEET_CONFIG_ROOT=./config.example
FLEET_SECRETS_PATH=./config.example/secrets/bsky-fleet.json
FLEET_DATA_ROOT=./data/fleet
DRY_RUN=true
FLEET_LOG_LEVEL=summary
FLEET_LOCK_PATH=./data/fleet/fleet.pid
FLEET_SHUTDOWN_PER_BOT_TIMEOUT_MS=10000
FLEET_SHUTDOWN_OVERALL_TIMEOUT_MS=30000
FLEET_MEMORY_LOG_INTERVAL_MS=60000
