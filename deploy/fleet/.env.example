# Copy to .env in this same directory (gitignored, never committed) and fill in real values.
# Both are optional - leave unset to disable the reply/mention/quote notification feature
# entirely; fleet posting is unaffected either way.

# Your own ntfy server/topic URL (see https://ntfy.sh).
NTFY_URL=

# Bearer token for an auth-protected ntfy topic. Omit if your topic allows
# unauthenticated publishing.
NTFY_TOKEN=
